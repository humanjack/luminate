# URL of the FastAPI backend that /api/llm/{research,content,script} proxy to.
# All API keys (Anthropic, OpenAI, Azure Speech, ...) are configured in the
# app's Settings page and stored in SQLite — not read from the environment.
# Set to "" to disable backend sync entirely.
BACKEND_URL=http://localhost:8000

# Public base URL, used for absolute OG/Twitter metadata URLs. Default localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Root for the SQLite DB (and media when set); default is the working dir.
# LUMINATE_DATA_DIR=/data

# Set to 1 to disable the in-memory rate limiter (local dev / tests).
# RATE_LIMIT_DISABLED=1
